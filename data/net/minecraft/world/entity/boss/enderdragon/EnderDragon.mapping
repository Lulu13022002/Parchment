	METHOD findPath (IILnet/minecraft/world/level/pathfinder/Node;)Lnet/minecraft/world/level/pathfinder/Path;
		COMMENT Find and return a path among the circles described by nodes, or {@code null} if the shortest path would just be directly between the start and finish with no intermediate points.
		COMMENT
		COMMENT Starting with nodes[startIndex], it searches the neighboring points (and their neighboring points, and so on) until it reaches nodes[finishIndex], at which point it calls reconstructPath to seal the deal.
		ARG 1 startIndex
		ARG 2 finishIndex
		ARG 3 andThen
