CLASS net/minecraft/world/item/WritableBookItem
	METHOD makeSureTagIsValid (Lnet/minecraft/nbt/CompoundTag;)Z
		COMMENT Returns {@code true} if the book's tag list "pages" is valid.
		ARG 0 tag
	METHOD use (Lnet/minecraft/world/level/Level;Lnet/minecraft/world/entity/player/Player;Lnet/minecraft/world/InteractionHand;)Lnet/minecraft/world/InteractionResultHolder;
		COMMENT Called to trigger the item's "innate" right click behavior. To handle when this item is used on a Block, see {@link #useOn}.
		ARG 1 level
		ARG 2 player
		ARG 3 hand
	METHOD useOn (Lnet/minecraft/world/item/context/UseOnContext;)Lnet/minecraft/world/InteractionResult;
		COMMENT Called when this item is used when targeting a Block
		ARG 1 context
