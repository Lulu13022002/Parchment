CLASS net/minecraft/world/item/enchantment/TridentImpalerEnchantment
	METHOD <init> (Lnet/minecraft/world/item/enchantment/Enchantment$Rarity;[Lnet/minecraft/world/entity/EquipmentSlot;)V
		ARG 1 rarity
		ARG 2 applicableSlots
	METHOD getDamageBonus (ILnet/minecraft/world/entity/MobType;)F
		COMMENT Calculates the amount of additional damage to deal when attacking with an item with the enchantment.
		ARG 1 level
		ARG 2 creatureType
	METHOD getMaxCost (I)I
		ARG 1 enchantmentLevel
	METHOD getMaxLevel ()I
		COMMENT Returns the maximum level that the enchantment can have.
	METHOD getMinCost (I)I
		COMMENT Returns the minimal value of enchantability needed on the enchantment level passed.
		ARG 1 enchantmentLevel
