CLASS net/minecraft/world/level/LevelWriter
	METHOD addFreshEntity (Lnet/minecraft/world/entity/Entity;)Z
		ARG 1 entity
	METHOD destroyBlock (Lnet/minecraft/core/BlockPos;Z)Z
		COMMENT Sets a block to air, but also plays the sound and particles and can spawn drops
		ARG 1 pos
		ARG 2 dropBlock
	METHOD destroyBlock (Lnet/minecraft/core/BlockPos;ZLnet/minecraft/world/entity/Entity;)Z
		ARG 1 pos
		ARG 2 dropBlock
		ARG 3 entity
	METHOD destroyBlock (Lnet/minecraft/core/BlockPos;ZLnet/minecraft/world/entity/Entity;I)Z
		ARG 1 pos
		ARG 2 dropBlock
		ARG 3 entity
		ARG 4 recursionLeft
	METHOD removeBlock (Lnet/minecraft/core/BlockPos;Z)Z
		ARG 1 pos
		ARG 2 movedByPiston
	METHOD setBlock (Lnet/minecraft/core/BlockPos;Lnet/minecraft/world/level/block/state/BlockState;I)Z
		ARG 1 pos
		ARG 2 state
		ARG 3 flags
	METHOD setBlock (Lnet/minecraft/core/BlockPos;Lnet/minecraft/world/level/block/state/BlockState;II)Z
		COMMENT Sets a block state into this world. Flags are as follows:
		COMMENT <ul>
		COMMENT <li>1 will notify neighboring block updates.</li>
		COMMENT <li>2 will send the change to clients.</li>
		COMMENT <li>4 will prevent the block from being re-rendered.</li>
		COMMENT <li>8 will force any re-renders to run on the main thread instead.</li>
		COMMENT <li>16 will prevent neighbor reactions (e.g. fences connecting, observers pulsing).</li>
		COMMENT <li>32 will prevent neighbor reactions from spawning drops.</li>
		COMMENT <li>64 will signify the block is being moved.</li>
		COMMENT </ul>
		COMMENT Flags can be OR-ed
		ARG 1 pos
		ARG 2 state
		ARG 3 flags
		ARG 4 recursionLeft
