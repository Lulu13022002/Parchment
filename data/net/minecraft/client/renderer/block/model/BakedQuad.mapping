CLASS net/minecraft/client/renderer/block/model/BakedQuad
	FIELD vertices [I
		COMMENT Joined 4 vertex records, each stores packed data according to the VertexFormat of the quad. Vanilla uses DefaultVertexFormat.BLOCK.
	METHOD <init> ([IILnet/minecraft/core/Direction;Lnet/minecraft/client/renderer/texture/TextureAtlasSprite;Z)V
		ARG 1 vertices
		ARG 2 tintIndex
		ARG 3 direction
		ARG 4 sprite
		ARG 5 shade
