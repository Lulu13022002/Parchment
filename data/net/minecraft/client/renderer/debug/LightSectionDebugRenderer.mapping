CLASS net/minecraft/client/renderer/debug/LightSectionDebugRenderer
	METHOD <init> (Lnet/minecraft/client/Minecraft;Lnet/minecraft/world/level/LightLayer;)V
		ARG 1 minecraft
		ARG 2 lightLayer
	METHOD renderEdge (IIIIIII)V
		ARG 0 x1
		ARG 1 y1
		ARG 2 z1
		ARG 3 x2
		ARG 4 y2
		ARG 5 z2
		ARG 6 color
	METHOD renderEdges (Lnet/minecraft/world/phys/shapes/DiscreteVoxelShape;Lnet/minecraft/core/SectionPos;I)V
		ARG 0 shape
		ARG 1 pos
		ARG 2 color
	METHOD renderFace (Lnet/minecraft/core/Direction;IIII)V
		ARG 0 direction
		ARG 1 x
		ARG 2 y
		ARG 3 z
		ARG 4 color
	METHOD renderFaces (Lnet/minecraft/world/phys/shapes/DiscreteVoxelShape;Lnet/minecraft/core/SectionPos;I)V
		ARG 0 shape
		ARG 1 pos
		ARG 2 color
	CLASS SectionData
		METHOD <init> (Lnet/minecraft/world/level/lighting/LevelLightEngine;Lnet/minecraft/core/SectionPos;ILnet/minecraft/world/level/LightLayer;)V
			ARG 1 levelLightEngine
			ARG 2 pos
			ARG 3 radius
			ARG 4 lightLayer
