CLASS net/minecraft/client/renderer/debug/PathfindingRenderer
	METHOD addPath (ILnet/minecraft/world/level/pathfinder/Path;F)V
		ARG 1 entityId
		ARG 2 path
		ARG 3 maxDistanceToWaypoint
	METHOD render (Lcom/mojang/blaze3d/vertex/PoseStack;Lnet/minecraft/client/renderer/MultiBufferSource;DDD)V
		ARG 1 poseStack
		ARG 2 bufferSource
		ARG 3 camX
		ARG 5 camY
		ARG 7 camZ
