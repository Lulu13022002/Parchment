CLASS net/minecraft/client/multiplayer/ServerData
	FIELD lan Z
		COMMENT {@code true} if the server is a LAN server
	METHOD copyFrom (Lnet/minecraft/client/multiplayer/ServerData;)V
		ARG 1 serverData
	METHOD getIconB64 ()Ljava/lang/String;
		COMMENT Returns the base-64 encoded representation of the server's icon, or {@code null} if not available
	METHOD isLan ()Z
		COMMENT Return {@code true} if the server is a LAN server
	METHOD read (Lnet/minecraft/nbt/CompoundTag;)Lnet/minecraft/client/multiplayer/ServerData;
		COMMENT Takes a CompoundTag with 'name' and 'ip' keys, returns a ServerData instance.
		ARG 0 tag
	METHOD setIconB64 (Ljava/lang/String;)V
		ARG 1 icon
	METHOD setResourcePackStatus (Lnet/minecraft/client/multiplayer/ServerData$ServerPackStatus;)V
		ARG 1 mode
	METHOD write ()Lnet/minecraft/nbt/CompoundTag;
		COMMENT Returns a CompoundTag with the server's name, IP and maybe an icon or acceptTextures.
